# Environment Variables for TowingSpecs
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Public URL for your Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe for server-side reads with RLS enforced
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser.
# Used only in admin import scripts run server-side or in CI.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://towingspecs.com
PUBLIC_SITE_NAME=TowingSpecs

# ─── Cloudflare Pages ────────────────────────────────────────────────────────
# Set these in Cloudflare Pages dashboard, not here.
# CF_ACCOUNT_ID=your-account-id
# CF_PAGES_PROJECT=towingspecs
