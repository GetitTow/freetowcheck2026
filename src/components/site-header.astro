---
/**
 * SiteHeader — sticky navigation for TowingSpecs
 * Keyboard-accessible, mobile-responsive, no JS required for desktop layout.
 */
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/vehicles/', label: 'Vehicles' },
  { href: '/trailer-matcher/', label: 'Trailer Matcher' },
  { href: '/compare/', label: 'Compare' },
  { href: '/coverage/', label: 'Coverage' },
  { href: '/guides/', label: 'Guides' },
  { href: '/methodology/', label: 'Methodology' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-nav" role="banner">
  <div class="container">
    <nav class="site-nav__inner" aria-label="Primary navigation">
      <!-- Logo / Wordmark -->
      <a href="/" class="site-nav__logo" aria-label="TowingSpecs — home">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <rect x="2" y="8" width="20" height="10" rx="2" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
          <circle cx="6.5" cy="18" r="2.25" fill="#3E6AE1"/>
          <circle cx="17.5" cy="18" r="2.25" fill="#3E6AE1"/>
          <path d="M2 11h4l2-3h8l2 3" stroke="#3E6AE1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        TowingSpecs
      </a>

      <!-- Desktop Navigation -->
      <ul class="site-nav__links" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['site-nav__link', { 'site-nav__link--active': isActive(link.href) }]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile menu button -->
      <button
        class="site-nav__mobile-btn btn btn--ghost btn--sm"
        id="mobile-menu-btn"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
        type="button"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M3 5h14M3 10h14M3 15h14"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="site-nav__mobile-menu" aria-hidden="true" role="dialog" aria-label="Mobile navigation">
    <ul role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={['site-nav__mobile-link', { 'site-nav__mobile-link--active': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .site-nav__mobile-btn {
    display: none;
  }

  .site-nav__mobile-menu {
    display: none;
    border-top: 1px solid var(--color-cloud-gray);
    background-color: var(--color-pure-white);
    padding: 0.75rem 0;
  }

  .site-nav__mobile-menu[aria-hidden="false"] {
    display: block;
  }

  .site-nav__mobile-link {
    display: block;
    padding: 0.75rem var(--container-pad);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-pewter);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .site-nav__mobile-link:hover,
  .site-nav__mobile-link--active {
    color: var(--color-carbon-dark);
    background-color: var(--color-light-ash);
  }

  @media (max-width: 768px) {
    .site-nav__links {
      display: none;
    }
    .site-nav__mobile-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      menu.setAttribute('aria-hidden', String(expanded));
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        btn.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
      }
    });
  }
</script>
