---
/**
 * SpecificationSource — displays the source citation for a towing specification
 */
interface Props {
  documentTitle: string;
  sourceUrl: string;
  publisher: string;
  pageNumber?: string | null;
  verificationDate: string;
}

const { documentTitle, sourceUrl, publisher, pageNumber, verificationDate } = Astro.props;

const formattedDate = new Date(verificationDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<div class="source-citation">
  <p class="source-citation__title">{documentTitle}</p>
  <p class="source-citation__meta">
    Published by {publisher}
    {pageNumber && ` · Page ${pageNumber}`}
    {` · Verified ${formattedDate}`}
  </p>
  <a
    href={sourceUrl}
    class="source-citation__link"
    target="_blank"
    rel="noopener noreferrer nofollow"
    aria-label={`View source document: ${documentTitle} (opens in new tab)`}
  >
    Open manufacturer source
    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true" style="display:inline;margin-left:0.2rem;">
      <path d="M2 8L8 2M8 2H4.5M8 2v3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</div>
