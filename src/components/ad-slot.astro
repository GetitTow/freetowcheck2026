---
/**
 * AdSlot.astro — Display Advertising Component
 *
 * Designed with fixed container dimensions and CSS aspect ratios to ensure
 * Zero Cumulative Layout Shift (CLS = 0) per Google Core Web Vitals guidelines.
 *
 * Ad Network Integration Guide:
 * When approved by Google AdSense, Raptive, Mediavine, or NitroPay:
 * 1. Insert the network script tag into src/layouts/Layout.astro head.
 * 2. Set the data-ad-client and data-ad-slot attributes within this component.
 * 3. Uncomment the client-side push trigger ((window.adsbygoogle = window.adsbygoogle || []).push({})).
 */

interface Props {
  slotId: string;
  format?: 'leaderboard' | 'rectangle' | 'banner';
  label?: string;
  class?: string;
}

const {
  slotId,
  format = 'rectangle',
  label = 'Advertisement',
  class: className = '',
} = Astro.props;

// Standard responsive dimensions to reserve exact vertical space
const dimensionMap = {
  leaderboard: { width: '728px', height: '90px', minHeight: '90px' },
  rectangle: { width: '300px', height: '250px', minHeight: '250px' },
  banner: { width: '100%', height: '100px', minHeight: '100px' },
};

const dimensions = dimensionMap[format] || dimensionMap.rectangle;

// Monetization disabled until audience threshold (100-150 daily visitors) is reached.
// Zero HTML, zero empty boxes, zero CLS impact.
const MONETIZATION_ENABLED = false;
if (!MONETIZATION_ENABLED) return null;
---

<aside
  class:list={['ad-slot-container', `ad-slot--${format}`, className]}
  aria-label="Advertisement"
  data-slot-id={slotId}
>
  <div class="ad-slot-label">{label}</div>
  <div
    class="ad-slot-box"
    style={`min-height: ${dimensions.minHeight}; max-width: ${dimensions.width};`}
  >
    {/*
      Production Network Placeholder:
      Until an ad network agreement is deployed, render a clean, non-intrusive container
      without pretending a live ad network is serving impressions.
    */}
    <div class="ad-slot-placeholder" aria-hidden="true">
      <span class="ad-slot-placeholder__text">Reserved Sponsor Placement ({dimensions.width} &times; {dimensions.height})</span>
    </div>
  </div>
</aside>

<style>
  .ad-slot-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 2rem auto;
    padding: 0.5rem;
    max-width: 100%;
    contain: layout paint;
  }

  .ad-slot-label {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-pewter, #71717a);
    margin-bottom: 0.375rem;
    align-self: center;
  }

  .ad-slot-box {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-light-ash, #f4f4f5);
    border: 1px dashed var(--color-cloud-gray, #e4e4e7);
    border-radius: var(--radius-card, 8px);
    overflow: hidden;
  }

  .ad-slot-placeholder {
    padding: 1.5rem 1rem;
    text-align: center;
  }

  .ad-slot-placeholder__text {
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-silver-fog, #a1a1aa);
    font-family: monospace;
  }

  @media (max-width: 768px) {
    .ad-slot--leaderboard .ad-slot-box {
      min-height: 50px !important;
    }
  }
</style>
