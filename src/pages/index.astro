---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/site-header.astro';
import SiteFooter from '../components/site-footer.astro';
import VehicleSearch from '../components/vehicle-search.astro';
import YearBrowser from '../components/year-browser.astro';
import SafetyDisclaimer from '../components/safety-disclaimer.astro';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://towingspecs.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TowingSpecs',
  url: siteUrl,
  description: 'Verified vehicle towing capacity, payload limits, and trailer compatibility. 100% source-backed specifications from manufacturer documentation.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/vehicles/search/?year={year}&make={make}&model={model}`,
    },
    'query-input': 'required name=model',
  },
};

const faqs = [
  {
    question: 'Why does towing capacity vary drastically on the exact same truck or SUV model?',
    answer: 'Towing capacity is engineered around specific mechanical equipment: engine displacement, turbocharging, axle gear ratio, cooling pack capacity, cab style, bed length, and factory tow packages. The headline rating in commercials applies only to the single highest-rated configuration—often a base regular-cab 2WD truck with an optional high-ratio rear axle and maximum trailering pack.',
  },
  {
    question: 'Why do most towing setups run out of payload capacity before reaching max tow rating?',
    answer: 'Every conventional bumper-pull trailer exerts 10% to 15% of its total loaded weight downward onto the vehicle\'s hitch ball as tongue weight. This tongue weight counts directly against your vehicle\'s payload capacity, alongside all passengers and cargo inside the cabin. A half-ton truck rated to tow 11,000 lbs might have only 1,500 lbs of payload—meaning a 1,100 lb tongue weight leaves just 400 lbs for all passengers and gear.',
  },
  {
    question: 'Where do I find my vehicle\'s actual true payload capacity?',
    answer: 'Never rely on brochure payload numbers. Check the yellow-and-white "Tire and Loading Information" sticker on the driver\'s B-pillar (door-jamb). It states: "The combined weight of occupants and cargo should never exceed XXX kg or XXX lbs." This label reflects your specific vehicle as it left the factory with all optional equipment installed.',
  },
  {
    question: 'What is GCWR and why is it often the ultimate legal limit?',
    answer: 'Gross Combined Weight Rating (GCWR) is the absolute maximum weight allowed for the towing vehicle, all passengers, all cargo, vehicle fuel, hitch equipment, and the loaded trailer combined on a certified scale. Exceeding GCWR strains vehicle braking, transmission cooling, and structural frame components even if individual axle ratings appear within limits.',
  },
  {
    question: 'What constitutes a factory tow package versus an aftermarket hitch receiver?',
    answer: 'A factory tow package typically includes heavy-duty engine oil and transmission fluid coolers, upgraded radiator fans, a higher-capacity alternator, a vehicle-specific wiring harness with integrated trailer brake controller (ITBC), and a frame-welded Class IV or Class V receiver. Simply bolting an aftermarket hitch onto a vehicle without the required factory tow equipment does not elevate its manufacturer towing limit.',
  },
  {
    question: 'Where do TowingSpecs ratings and specifications come from?',
    answer: 'Every specification on TowingSpecs is sourced exclusively from official manufacturer primary sources: owner manuals, official fleet towing guides, technical spec sheets, and pressroom engineering releases. Every rating displays its verified document title, publisher, page or section citation, and audit date.',
  },
];

// Popular vehicles genuinely backed by records in the catalog
const popularVehicles = [
  {
    make: 'Ford',
    model: 'F-150',
    slug: 'ford/f-150',
    type: 'Full-Size Pickup',
    headlineTow: 'Up to 14,000 lbs',
    years: [2013, 2025],
    desc: '3.5L EcoBoost V6 SuperCrew, 5.0L V8, and 2.7L EcoBoost configurations with Max Trailer Tow package.',
    specs: 'Max Tow: 14,000 lbs · Tongue: 1,400 lbs · Payload: 2,445 lbs',
  },
  {
    make: 'Chevrolet',
    model: 'Silverado 1500',
    slug: 'chevrolet/silverado-1500',
    type: 'Full-Size Pickup',
    headlineTow: 'Up to 13,300 lbs',
    years: [2013, 2025],
    desc: '6.2L EcoTec3 V8 & 5.3L V8 with NHT Max Trailering Package, 3.42 axle ratio, and integrated brake controller.',
    specs: 'Max Tow: 13,300 lbs · Tongue: 1,330 lbs · Payload: 2,180 lbs',
  },
  {
    make: 'Ram',
    model: '1500',
    slug: 'ram/1500',
    type: 'Full-Size Pickup',
    headlineTow: 'Up to 11,550 lbs',
    years: [2013, 2025],
    desc: 'All-new 3.0L Hurricane Twin-Turbo I6 (420 hp) and historical 5.7L HEMI V8 with 3.92 axle ratio.',
    specs: 'Max Tow: 11,550 lbs · Tongue: 1,155 lbs · Payload: 1,980 lbs',
  },
  {
    make: 'Toyota',
    model: 'Tacoma',
    slug: 'toyota/tacoma',
    type: 'Mid-Size Pickup',
    headlineTow: 'Up to 6,500 lbs',
    years: [2013, 2021, 2024, 2025],
    desc: '4th-Gen 2.4L Turbo i-FORCE TRD Off-Road, 3rd-Gen 3.5L V6, and historical 2013 4.0L V6 (SAE J2807 certified).',
    specs: 'Max Tow: 6,500 lbs · Tongue: 650 lbs · Payload: 1,705 lbs',
  },
  {
    make: 'Toyota',
    model: 'Tundra',
    slug: 'toyota/tundra',
    type: 'Full-Size Pickup',
    headlineTow: 'Up to 12,000 lbs',
    years: [2013, 2021, 2024, 2025],
    desc: 'Twin-Turbo 3.4L i-FORCE V6 CrewMax & Double Cab, alongside legendary 5.7L i-FORCE V8 benchmark.',
    specs: 'Max Tow: 12,000 lbs · Tongue: 1,200 lbs · Payload: 1,875 lbs',
  },
  {
    make: 'Subaru',
    model: 'Outback',
    slug: 'subaru/outback',
    type: 'AWD Crossover Wagon',
    headlineTow: 'Up to 3,500 lbs',
    years: [2024],
    desc: 'Wilderness 2.4L Turbo AWD with high-capacity transmission oil cooler (3,500 lbs) vs Premium 2.5L (2,700 lbs).',
    specs: 'Max Tow: 3,500 lbs · Tongue: 350 lbs · Payload: 1,150 lbs',
  },
  {
    make: 'Honda',
    model: 'Pilot',
    slug: 'honda/pilot',
    type: '3-Row Mid-Size SUV',
    headlineTow: 'Up to 5,000 lbs',
    years: [2024],
    desc: 'TrailSport 3.5L V6 AWD with standard heavy-duty ATF cooler (5,000 lbs) vs EX-L 2WD (3,500 lbs).',
    specs: 'Max Tow: 5,000 lbs · Tongue: 500 lbs · Payload: 1,450 lbs',
  },
  {
    make: 'Jeep',
    model: 'Wrangler',
    slug: 'jeep/wrangler',
    type: 'Off-Road 4x4 SUV',
    headlineTow: 'Up to 5,000 lbs',
    years: [2024],
    desc: 'Rubicon 4-Door with Dana 44 HD full-float rear axle (5,000 lbs) vs standard Sport 4-Door (3,500 lbs).',
    specs: 'Max Tow: 5,000 lbs · Tongue: 500 lbs · Payload: 1,250 lbs',
  },
  {
    make: 'Nissan',
    model: 'Frontier',
    slug: 'nissan/frontier',
    type: 'Mid-Size Pickup',
    headlineTow: 'Up to 6,270 lbs',
    years: [2024],
    desc: '3.8L Direct-Injection V6 (310 hp) PRO-4X Crew Cab 4x4 with factory Class IV hitch package.',
    specs: 'Max Tow: 6,270 lbs · Tongue: 627 lbs · Payload: 1,220 lbs',
  },
];
---

<Layout
  title="TowingSpecs — Can Your Vehicle Tow Your Trailer? Verified US Specs"
  description="Determine whether your pickup truck, SUV, or crossover can safely tow your trailer. Exact manufacturer specifications, payload limits, tongue weight, and GCWR calculations."
  canonicalUrl="/"
  jsonLd={jsonLd}
>
  <SiteHeader currentPath="/" />

  <main id="main-content">

    <!-- ─── 1. Hero: Can Your Vehicle Tow Your Trailer? ─────────────────────── -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container">
        <div class="hero__layout">
          <div class="hero__content">
            <div class="hero__badge-row">
              <span class="hero__eyebrow-badge">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="#38bdf8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Independent US Automotive Reference
              </span>
              <span class="hero__scope-pill">17-Year Scope: 2010–2026</span>
            </div>

            <h1 class="hero__title" id="hero-heading">
              Can Your Vehicle<br />
              Tow Your Trailer?
            </h1>

            <p class="hero__subtitle">
              Safe towing depends on exact vehicle trim, engine, drivetrain, driver door-jamb payload,
              hitch equipment, and loaded tongue weight—not just the advertised headline rating.
            </p>

            <div class="hero__ctas">
              <a href="/trailer-matcher/" class="btn btn--accent btn--lg hero__action-btn">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <rect x="2" y="9" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.75"/>
                  <rect x="12" y="6" width="6" height="10" rx="1.5" stroke="currentColor" stroke-width="1.75"/>
                  <circle cx="5" cy="16" r="1.5" fill="currentColor"/>
                  <circle cx="15" cy="16" r="1.5" fill="currentColor"/>
                </svg>
                Check My Trailer
              </a>
              <a href="/compare/" class="btn btn--secondary-hero btn--lg">
                Compare 2–3 Vehicles
              </a>
            </div>

            <div class="hero__trust">
              <span class="hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="#38bdf8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Primary manufacturer documents
              </span>
              <span class="hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="#38bdf8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Exact configuration-specific limits
              </span>
              <span class="hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3.5 3.5L12 3" stroke="#38bdf8" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Zero sponsored ratings or ads
              </span>
            </div>
          </div>

          <!-- Prominent Vehicle Lookup Card -->
          <div class="hero__lookup">
            <div class="lookup-panel">
              <div class="lookup-panel__header">
                <h2 class="lookup-panel__title">Vehicle Specification Lookup</h2>
                <span class="lookup-panel__caption">Step 1 of 3: Select Vehicle</span>
              </div>
              <VehicleSearch />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 2. Core Navigation Tools Grid ───────────────────────────────────── -->
    <section class="section section--sm" aria-labelledby="tools-heading">
      <div class="container">
        <h2 class="sr-only" id="tools-heading">Automotive Research Tools</h2>
        <div class="tools-grid">
          <a href="/trailer-matcher/" class="tool-card tool-card--featured" aria-label="Trailer Matcher: calculate vehicle and trailer compatibility">
            <div class="tool-card__icon tool-card__icon--accent">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="12" width="16" height="9" rx="2" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
                <rect x="16" y="9" width="10" height="12" rx="2" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
                <circle cx="6" cy="21" r="2.25" fill="#3E6AE1"/>
                <circle cx="22" cy="21" r="2.25" fill="#3E6AE1"/>
              </svg>
            </div>
            <div class="tool-card__content">
              <div class="tool-card__badge-row">
                <h3 class="tool-card__title">Trailer Matcher</h3>
                <span class="pill-badge pill-badge--accent">Signature Tool</span>
              </div>
              <p class="tool-card__desc">Test vehicle vs. trailer: towing capacity, driver door payload, tongue load, and GCWR.</p>
            </div>
            <span class="tool-card__arrow">→</span>
          </a>

          <a href="/vehicles/" class="tool-card" aria-label="Browse vehicle specifications by make and model">
            <div class="tool-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="9" width="24" height="12" rx="2.5" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
                <circle cx="7" cy="21" r="2.5" fill="#3E6AE1"/>
                <circle cx="21" cy="21" r="2.5" fill="#3E6AE1"/>
                <path d="M2 13h5l3-4h8l3 4" stroke="#3E6AE1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="tool-card__content">
              <h3 class="tool-card__title">Browse All Vehicles</h3>
              <p class="tool-card__desc">Explore 71 verified configurations across 9 US-market manufacturers.</p>
            </div>
            <span class="tool-card__arrow">→</span>
          </a>

          <a href="/compare/" class="tool-card" aria-label="Compare towing capacity side-by-side between vehicles">
            <div class="tool-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="8" width="11" height="13" rx="2" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
                <rect x="15" y="8" width="11" height="13" rx="2" stroke="#3E6AE1" stroke-width="1.75" fill="none"/>
                <path d="M13 14h2M5 13h5M18 13h5" stroke="#3E6AE1" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="tool-card__content">
              <h3 class="tool-card__title">Vehicle Comparison</h3>
              <p class="tool-card__desc">Side-by-side comparison of tow ratings, GCWR, payload, and hitch requirements.</p>
            </div>
            <span class="tool-card__arrow">→</span>
          </a>

          <a href="/coverage/" class="tool-card" aria-label="View the 2010–2026 Vehicle Coverage Dashboard">
            <div class="tool-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="22" height="22" rx="3" stroke="#3E6AE1" stroke-width="1.75"/>
                <path d="M3 10h22M10 10v15M17 10v15" stroke="#3E6AE1" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="tool-card__content">
              <h3 class="tool-card__title">Coverage Dashboard</h3>
              <p class="tool-card__desc">Live catalog breakdown, verification status, and 2010–2026 expansion roadmap.</p>
            </div>
            <span class="tool-card__arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── 3. Popular Vehicles Section (Based Exclusively on Real Dataset) ─── -->
    <section class="section" aria-labelledby="popular-heading">
      <div class="container">
        <div class="section__header-row">
          <div>
            <p class="section__eyebrow">Verified US Catalog</p>
            <h2 class="section__title" id="popular-heading">Popular Towing Vehicles</h2>
            <p class="section__desc">
              Every rating below is backed by verified primary manufacturer documentation. Select any model to view exact configuration breakdowns.
            </p>
          </div>
          <a href="/vehicles/" class="btn btn--secondary btn--sm">
            View All 27 Models →
          </a>
        </div>

        <div class="vehicles-grid">
          {popularVehicles.map((v) => (
            <a href={`/vehicles/${v.slug}/`} class="vehicle-card" aria-label={`View ${v.make} ${v.model} towing specs`}>
              <div class="vehicle-card__header">
                <span class="vehicle-card__type">{v.type}</span>
                <span class="vehicle-card__tow-badge">{v.headlineTow}</span>
              </div>
              <h3 class="vehicle-card__title">{v.make} {v.model}</h3>
              <p class="vehicle-card__desc">{v.desc}</p>
              <div class="vehicle-card__specs-row">
                <span class="vehicle-card__specs">{v.specs}</span>
              </div>
              <div class="vehicle-card__footer">
                <div class="vehicle-card__years">
                  {v.years.map((y) => (
                    <span class="year-chip">{y}</span>
                  ))}
                </div>
                <span class="vehicle-card__cta">View Specs →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── 4. Year Browser (All 17 Years in Catalog Scope) ─────────────────── -->
    <YearBrowser />

    <!-- ─── 5. How Towing Limits Work ──────────────────────────────────────── -->
    <section class="section section--alt" aria-labelledby="limits-heading">
      <div class="container">
        <div class="section__header" style="max-width: 780px;">
          <p class="section__eyebrow">Engineering Fundamentals</p>
          <h2 class="section__title" id="limits-heading">
            How Towing Limits Actually Work
          </h2>
          <p class="section__desc">
            A vehicle does not have a single "tow capacity." Safe towing requires respecting five independent physical constraints simultaneously. Exceeding any one limit makes the setup unsafe and illegal.
          </p>
        </div>

        <div class="concepts-grid">
          <div class="concept-card">
            <div class="concept-card__badge">Limit 1</div>
            <h3 class="concept-card__title">Maximum Towing Capacity (GTW)</h3>
            <p class="concept-card__body">
              The maximum loaded trailer weight the vehicle chassis, drivetrain, and cooling systems are certified to pull under SAE J2807 standards. Varies drastically with cab style, bed length, and axle ratio.
            </p>
            <div class="concept-card__formula">
              <strong>Formula:</strong> Gross Trailer Weight ≤ Manufacturer Rated Max Tow
            </div>
            <a href="/guides/towing-capacity-explained/" class="concept-card__link">Read full towing guide →</a>
          </div>

          <div class="concept-card">
            <div class="concept-card__badge">Limit 2</div>
            <h3 class="concept-card__title">Vehicle Payload Capacity</h3>
            <p class="concept-card__body">
              The maximum weight your vehicle can carry—including driver, all passengers, luggage, and trailer tongue weight pushing down on the hitch ball. This is usually the first limit exceeded on half-ton trucks and SUVs.
            </p>
            <div class="concept-card__formula">
              <strong>Formula:</strong> Passengers + Cargo + Tongue Weight ≤ Door-Jamb Payload
            </div>
            <a href="/guides/payload-capacity/" class="concept-card__link">Read payload guide →</a>
          </div>

          <div class="concept-card">
            <div class="concept-card__badge">Limit 3</div>
            <h3 class="concept-card__title">Tongue Weight Limit & Ratio</h3>
            <p class="concept-card__body">
              For conventional bumper-pull trailers, 10% to 15% of total trailer weight must rest on the hitch ball. Less than 10% causes lethal trailer sway; more than 15% overloads the rear axle and lightens steering.
            </p>
            <div class="concept-card__formula">
              <strong>Guidance:</strong> 10%–15% conventional trailer weight & ≤ Hitch Receiver Rating
            </div>
            <a href="/guides/tongue-weight/" class="concept-card__link">Read tongue weight guide →</a>
          </div>

          <div class="concept-card">
            <div class="concept-card__badge">Limit 4</div>
            <h3 class="concept-card__title">Gross Combined Weight (GCWR)</h3>
            <p class="concept-card__body">
              The maximum allowable weight of the entire combination—vehicle, passengers, luggage, fuel, and fully loaded trailer weighed together on a certified scale.
            </p>
            <div class="concept-card__formula">
              <strong>Formula:</strong> Loaded Vehicle + Loaded Trailer ≤ Manufacturer GCWR
            </div>
            <a href="/guides/gcwr/" class="concept-card__link">Read GCWR guide →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 6. Data Quality & Verification Methodology ─────────────────────── -->
    <section class="section" aria-labelledby="quality-heading">
      <div class="container">
        <div class="quality-grid">
          <div class="quality-text">
            <p class="section__eyebrow">Data Transparency & Governance</p>
            <h2 class="section__title" id="quality-heading">
              100% Primary Manufacturer Sources
            </h2>
            <p class="quality-desc">
              TowingSpecs was built to replace unverified marketing claims, scraped forum estimates, and misleading competitor databases. Every specification is validated against official OEM documentation.
            </p>

            <div class="quality-checklist">
              <div class="quality-check-item">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="#f0faf4" stroke="#1a7a4a" stroke-width="1.5"/>
                  <path d="M6 10l3 3 5-5" stroke="#1a7a4a" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                  <strong>No AI Hallucinations or Estimated Ratings</strong>
                  <p>We never infer a vehicle's rating from a neighboring model year or guess based on engine size.</p>
                </div>
              </div>

              <div class="quality-check-item">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="#f0faf4" stroke="#1a7a4a" stroke-width="1.5"/>
                  <path d="M6 10l3 3 5-5" stroke="#1a7a4a" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                  <strong>Audit Dates & Exact Document Citations</strong>
                  <p>Every vehicle page links directly to its primary source: owner manual, towing guide, or spec sheet.</p>
                </div>
              </div>

              <div class="quality-check-item">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="10" cy="10" r="9" fill="#f0faf4" stroke="#1a7a4a" stroke-width="1.5"/>
                  <path d="M6 10l3 3 5-5" stroke="#1a7a4a" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                  <strong>Zero Commercial Monetization Interference</strong>
                  <p>No sponsored rankings, no affiliate equipment cards, and no paid manufacturer bias.</p>
                </div>
              </div>
            </div>

            <div class="quality-actions">
              <a href="/methodology/" class="btn btn--secondary">
                Read Data Verification Methodology
              </a>
              <a href="/coverage/" class="btn btn--ghost">
                Inspect Live Coverage Metrics →
              </a>
            </div>
          </div>

          <!-- Quality Stats Card -->
          <div class="quality-stats-card">
            <h3 class="quality-stats-title">Live Repository Verification Audit</h3>
            <div class="stats-row">
              <span class="stat-label">Published Configurations</span>
              <span class="stat-val">71</span>
            </div>
            <div class="stats-row">
              <span class="stat-label">Verified Towing Specifications</span>
              <span class="stat-val">71</span>
            </div>
            <div class="stats-row">
              <span class="stat-label">Supported US Manufacturers</span>
              <span class="stat-val">9</span>
            </div>
            <div class="stats-row">
              <span class="stat-label">Documented Vehicle Models</span>
              <span class="stat-val">27</span>
            </div>
            <div class="stats-row">
              <span class="stat-label">Primary Source Citations</span>
              <span class="stat-val">28</span>
            </div>
            <div class="stats-row">
              <span class="stat-label">Unverified Guesses Allowed</span>
              <span class="stat-val stat-val--zero">0</span>
            </div>

            <div class="quality-stats-footer">
              <span class="audit-status-badge">
                <span class="audit-dot"></span>
                Dataset Health: 100% Passed Physics Audit
              </span>
              <p class="audit-footnote">Updated synchronously with database migrations & seed validations.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 7. US-Focused Guides & Knowledge Base ───────────────────────────── -->
    <section class="section section--alt" aria-labelledby="guides-heading">
      <div class="container">
        <div class="section__header-row">
          <div>
            <p class="section__eyebrow">Practical Knowledge</p>
            <h2 class="section__title" id="guides-heading">US Towing Guides & Real-World Advice</h2>
            <p class="section__desc">Clear answers to complex towing questions, backed by automotive engineering standards.</p>
          </div>
          <a href="/guides/" class="btn btn--secondary btn--sm">
            All Guides & Tutorials →
          </a>
        </div>

        <div class="guides-grid">
